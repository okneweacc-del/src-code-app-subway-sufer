  "LOADING_PROGRESS_TEXT": "LOADING...",
  "LOADING_TIP_01": "Stay on top of trains\r\nto get a better view\r\nof what's coming!",
  "LOADING_TIP_02": "Pick up the 2X Multiplier\r\nto double the score you earn!",
  "LOADING_TIP_03": "Jump barriers, dodge trains\r\n- and don't let\r\nthe Inspector catch you!",
  "LOADING_TIP_04": "Surf the trains\r\nas far as possible\r\nto set a new highscore!",
  "LOADING_TIP_05": "Get the Double Coins Booster\r\nto increase every Coin pickup!",
  "LOADING_TIP_06": "Find your favorite\r\ncharacters in the Me menu!",
  "LOADING_TIP_07": "Complete Word Hunt\r\neach day and\r\nincrease your reward!",
  "LOADING_TIP_08": "Upgrade your preferred\r\npowerups in the Shop\r\nto make them last longer!",
  "LOADING_TIP_09": "Join your friends on Facebook\r\nand show off your skills!",
  "LOADING_TIP_10": "Complete missions\r\nto increase your Multiplier\r\nup to x30!",
  "LOADING_TIP_11": "Reached Multiplier 30?\r\nComplete extra missions\r\nfor Super Mystery Boxes!",
  "LOADING_TIP_12": "Earn Coins for your friends\r\nby making multiple runs!",
  "LOADING_TIP_13": "Go to the Top Run menu \r\nto get Coin bonuses \r\nfrom your friends!",
  "LOADING_TIP_14": "Switch lanes in mid-air\r\nto dodge trains\r\nat the last minute!",
  "LOADING_TIP_15": "Double tap the screen\r\nto grab a Hoverboard!",
  "LOADING_TIP_16": "Use Hoverboards\r\nto avoid crashing!",
  "LOADING_TIP_17": "Discover secret Trophies\r\nin Mystery Boxes!",
  "LOADING_TIP_18": "Reach the top of \r\nthe High Scores list by \r\nincreasing your Multiplier!",
  "LOADING_TIP_19": "Open Mystery Boxes\r\n- go for the Jackpot!",
  "LOADING_TIP_20": "Catch those letters\r\nto complete the Word Hunt!",
  "LOADING_TIP_21": "Surf the trains\r\nfor a better view!",
  "LOADING_TIP_22": "Put on your\r\npaint powered Jetpack\r\nto glide with style!",
  "LOADING_TIP_23": "The 2X Multiplier\r\ndoubles your Multiplier\r\ntemporarily!",
  "LOADING_TIP_24": "Skip Missions in the Shop!",
  "LOADING_TIP_25": "Use the bouncy\r\nSuper Sneakers\r\nto jump over trains!",
  "LOADING_TIP_26": "Swipe down in mid-air\r\nto master the Super Sneakers!",
  "LOADING_TIP_27": "Use Headstarts\r\nfor a helping hand!",
  "LOADING_TIP_28": "Unlock Tricky\r\nby collecting specific\r\nCharacter Tokens!",
  "LOADING_TIP_29": "Unlock Fresh\r\nby collecting specific\r\nCharacter Tokens!",
  "LOADING_TIP_30": "Unlock Spike\r\nby collecting specific\r\nCharacter Tokens!",
  "LOADING_TIP_31": "Unlock Yutani\r\nby collecting specific\r\nCharacter Tokens!",
  "LOADING_TIP_32": "Reach goals to win\r\nBronze, Silver and\r\nGold Awards",
  "LOADING_TIP_33": "Collect rare Trophies\r\nfrom Mystery Boxes\r\nand Super Mystery Boxes",
  "LOADING_TIP_34": "Swipe down at any time\r\nduring a Power Jump\r\nto land immediately",
  "LOADING_TIP_35": "Join the Wild Wednesday fun\r\nevery week",
  "LOADING_TIP_36": "Collect surprising\r\nSuper Mysterizers\r\non Mystery Mondays",
  "LOADING_TIP_37": "Find Awards\r\nin the Me menu",
