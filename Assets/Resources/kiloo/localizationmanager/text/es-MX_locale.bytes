  "LEADERBOARD_HEADER_GAMECENTER": "GAMECENTER",
  "LIMITED_TIME_OFFER": "Oferta por Tiempo Limitado",
  "LOADING_PROGRESS_TEXT": "CARGANDO\u2026",
  "LOADING_TIP_01": "\u00a1Qu\u00e9date sobre los\r\ntrenes para ver mejor\r\nlo que se aproxima!",
  "LOADING_TIP_02": "\u00a1Recoge el Multiplicador 2X\r\npara duplicar tu puntuaci\u00f3n!",
  "LOADING_TIP_03": "\u00a1Salta barreras, esquiva\r\ntrenes y no dejes que\r\nel inspector te atrape!",
  "LOADING_TIP_04": "\u00a1Surfea por los trenes\r\ntan lejos como te sea posible\r\npara lograr una nueva marca!",
  "LOADING_TIP_05": "\u00a1Consigue el potenciador de Monedas\r\nDobles para aumentar las que recojas!",
  "LOADING_TIP_06": "\u00a1Encuentra tus personajes\r\nfavoritos en el men\u00fa Yo!",
  "LOADING_TIP_07": "\u00a1Completa Caza Palabras \r\n cada d\u00eda y \r\n aumenta tus recompensas!",
  "LOADING_TIP_08": "\u00a1Mejora tus poderes\r\nfavoritos en la Shop\r\npara que duren m\u00e1s!",
  "LOADING_TIP_09": "\u00a1\u00danete a tus amigos en Facebook\r\ny presume tus habilidades!",
  "LOADING_TIP_10": "\u00a1Completa misiones para\r\naumentar tu Multiplicador\r\nhasta x30!",
  "LOADING_TIP_11": "\u00bfAlcanzaste el Multiplicador 30?\r\n\u00a1Completa misiones extra para\r\nganar Cajas Supermisteriosas!",
  "LOADING_TIP_12": "\u00a1Gana Monedas para tus amigos\r\nhaciendo m\u00faltiples carreras!",
  "LOADING_TIP_13": "\u00a1Ve al men\u00fa de Top Run para \r\nobtener bonificaciones \r\nde Monedas de tus amigos!",
  "LOADING_TIP_14": "\u00a1Cambia de carril al vuelo\r\npara esquivar trenes\r\nen el \u00faltimo segundo!",
  "LOADING_TIP_15": "\u00a1Toca r\u00e1pido dos veces\r\npara tomar una Tabla Flotante!",
  "LOADING_TIP_16": "\u00a1Usa las Tablas Flotantes\r\npara evitar estrellarte!",
  "LOADING_TIP_17": "\u00a1Descubre trofeos secretos\r\nen las Cajas Misteriosas!",
  "LOADING_TIP_18": "\u00a1Alcanza la cima de \r\nla lista de Marcas al \r\nincrementar tu Multiplicador!",
  "LOADING_TIP_19": "\u00a1Abre Cajas Misteriosas\r\ny ve por el premio mayor!",
  "LOADING_TIP_20": "\u00a1Atrapa esas letras para \r\n completar la Caza Palabras!",
  "LOADING_TIP_21": "\u00a1Surfea los trenes para\r\ntener una mejor vista!",
  "LOADING_TIP_22": "\u00a1Ponte tu Mochila Cohete\r\npropulsada por pintura\r\npara moverte con estilo!",
  "LOADING_TIP_23": "\u00a1El Multiplicador 2X\r\nduplica tu Multiplicador\r\ntemporalmente!",
  "LOADING_TIP_24": "\u00a1Salta Misiones en la Shop!",
  "LOADING_TIP_25": "\u00a1Usa los Supertenis\r\nsaltarines para\r\nsaltar sobre los trenes!",
  "LOADING_TIP_26": "\u00a1Arr\u00e1strate al vuelo para\r\ndominar los Supertenis!",
  "LOADING_TIP_27": "\u00a1Usa las Ventajas\r\npara recibir una ayuda!",
  "LOADING_TIP_28": "\u00a1Desbloquea a Tricky\r\nreuniendo Fichas \r\nespec\u00edficas del Personaje!",
  "LOADING_TIP_29": "\u00a1Desbloquea a Fresh\r\nreuniendo Fichas\r\nespec\u00edficas del Personaje!",
  "LOADING_TIP_30": "\u00a1Desbloquea a Spike\r\nreuniendo Fichas\r\nespec\u00edficas del Personaje!",
  "LOADING_TIP_31": "\u00a1Desbloquea a Yutani\r\nreuniendo Fichas\r\nespec\u00edficas del Personaje!",
  "LOADING_TIP_32": "Alcanza metas para\r\nganar Galardones de\r\nBronce, Plata y Oro",
  "LOADING_TIP_33": "Re\u00fane trofeos raros\r\nde las Cajas Misteriosas\r\ny Cajas Supermisteriosas",
  "LOADING_TIP_34": "Ag\u00e1chate durante un\r\nsalto potente para\r\naterrizar inmediatamente",
  "LOADING_TIP_35": "\u00danete a la diversi\u00f3n del mi\u00e9rcoles\r\nsalvaje cada semana",
  "LOADING_TIP_36": "Re\u00fane sorprendentes\r\nsupermistificadores\r\nlos lunes misteriosos",
  "LOADING_TIP_37": "Encuentra Galardones\r\nen el men\u00fa Yo",
  "LOAD_LEVEL_CTRL_TIP_MESSAGE": "\u00a1Aqu\u00ed tienes un tip!",
