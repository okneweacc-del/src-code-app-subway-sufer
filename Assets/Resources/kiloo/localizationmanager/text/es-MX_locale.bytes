  "AWARDS_TITLE": "Galardones",
  "AWARD_10_DESCRIPTION": "{0}\u00a1V\u00edstete para lucir de lo mejor! Adu\u00e9\u00f1ate de{1} {2}{3}{4} {5}Trajes.{6}",
  "AWARD_10_TITLE": "Luciendo bien",
  "AWARD_11_DESCRIPTION": "{0}\u00a1El oro es in\u00fatil! Anota{1} {2}{3}{4} {5}en una carrera sin reunir Monedas.{6}",
  "AWARD_11_TITLE": "Cauteloso con Monedas",
  "AWARD_12_DESCRIPTION": "{0}\u00a1Surfea con un mayor prop\u00f3sito! Completa{1} {2}{3}{4} {5}misiones en una carrera.{6}",
  "AWARD_12_TITLE": "Maestro de Misiones",
  "AWARD_13_DESCRIPTION": "{0}\u00a1Abrillanta tu colecci\u00f3n de Monedas! Consigue{1} {2}{3}{4} {5}medallas de oro en Top Run.{6}",
  "AWARD_13_TITLE": "Surfista de oro",
  "AWARD_14_DESCRIPTION": "{0}\u00a1Corre como un canguro! Usa los Supertenis{1} {2}{3}{4} {5}minutos seguidos.{6}",
  "AWARD_14_DESCRIPTION_ONEITEM_GOAL": "{0}\u00a1Corre como un canguro! Usa los Supertenis por{1} {2}{3}{4} {5}minutos seguidos.{6}",
  "AWARD_14_TITLE": "Saltador de altura",
  "AWARD_15_DESCRIPTION": "{0}\u00a1El tiempo lo es todo! Re\u00fane exactamente{1} {2}{3}{4} {5}Monedas en una carrera.{6}",
  "AWARD_15_TITLE": "Contador de Monedas",
  "AWARD_16_DESCRIPTION": "{0}\u00a1Un poco de competencia extra nunca hace da\u00f1o! Da codazos{1} {2}{3}{4} {5}veces a amigos.{6}",
  "AWARD_16_TITLE": "Mejor de los amigos",
  "AWARD_17_DESCRIPTION": "{0}\u00a1Desbloquea tu actitud surfista! Recoge{1} {2}{3}{4} {5}Llaves en el subterr\u00e1neo.{6}",
  "AWARD_17_TITLE": "Maestro cerrajero",
  "AWARD_18_DESCRIPTION": "{0}\u00a1Descubre tu suerte en el subterr\u00e1neo! Abre{1} {2}{3}{4} {5}Cajas Misteriosas.{6}",
  "AWARD_18_TITLE": "Maestro del misterio",
  "AWARD_19_DESCRIPTION": "{0}\u00a1Mu\u00e9strales de qu\u00e9 est\u00e1s hecho! Derrota{1} {2}{3}{4} {5}amigos en Top Run.{6}",
  "AWARD_19_TITLE": "Amo del Top Run",
  "AWARD_1_TITLE": "Cazador de trofeos",
  "AWARD_20_DESCRIPTION": "{0}Anota{1} {2}{3}{4} {5}en una carrera sin saltar o rodar.{6}",
  "AWARD_20_TITLE": "Sin acrobacias",
  "AWARD_21_DESCRIPTION": "{0}\u00a1Anima tu fin de semana! Completa{1} {2}{3}{4} {5}retos del Fin de Semana Verboso.{6}",
  "AWARD_21_TITLE": "Fin de semana divertido",
  "AWARD_22_DESCRIPTION": "{0}\u00a1Pon tu suerte a prueba! Gana el premio mayor{1} {2}{3}{4} {5}veces.{6}",
  "AWARD_22_DESCRIPTION_ONEITEM": "{0}\u00a1Pon tu suerte a prueba! Gana el premio mayor{1} {2}{3}{4} {5}vez.{6}",
  "AWARD_22_TITLE": "Festival de premios mayores",
  "AWARD_23_DESCRIPTION": "{0}Completa{1} {2}{3}{4} {5}retos del Fin de Semana Verboso el un mismo fin de semana.{6}",
  "AWARD_23_TITLE": "Campe\u00f3n del fin de semana",
  "AWARD_24_DESCRIPTION": "{0}\u00a1Los misterios siguen acumul\u00e1ndose! Abre{1} {2}{3}{4} {5}Cajas Supermisteriosas.{6}",
  "AWARD_24_TITLE": "Maestro del Supermisterio",
  "AWARD_25_DESCRIPTION": "{0}\u00a1Feliz cacer\u00eda! Completa la Cacer\u00eda Semanal en una carrera{1} {2}{3}{4} {5}veces.{6}",
  "AWARD_25_TITLE": "Gran cazador",
